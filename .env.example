
# Admin
# Hardcoded super admin (never stored in the users table). Login is disabled if either is unset.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: HMAC key for admin session cookies (>=16 chars). Required in production if you do not set SUPER_ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Optional: where the editable site config JSON is persisted (default: ./data/site-config.json)
SITE_CONFIG_PATH=
