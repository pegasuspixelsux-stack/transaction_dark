
# Admin
# Hardcoded super admin (never stored in the users table). Login is disabled if either is unset.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional: HMAC key for admin session cookies (>=16 chars). Required in production if you do not set SUPER_ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Optional: where the editable site config JSON is persisted (default: ./data/site-config.json)
SITE_CONFIG_PATH=

# Firebase (staff login + user management). Web config from Firebase console > Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK key: local file path OR (on Vercel) the JSON / base64 of the JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=
